{
  "name": "poolscanner-poc",
  "version": "0.2.2",
  "private": true,
  "type": "commonjs",
  "description": "POC for decoding Solana pool accounts and computing spot prices.",
  "scripts": {
    "app": "dotenvx run -- node app.js",
    "inspect": "dotenvx run -- node inspectAccount.js",
    "decode:pool": "dotenvx run -- node tools/decodePool.js",
    "price:pool": "dotenvx run -- node tools/priceFromPool.js",
    "test": "jest"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@dotenvx/dotenvx": "^1.51.4",
    "@solana-tracker/data-api": "^0.2.0",
    "@solana/kit": "^5.4.0",
    "@solana/web3.js": "^1.98.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
