# Solana RPC endpoint (HTTP). The app derives WSS from this URL.
RPC_URL=https://rpc-mainnet.solanatracker.io/?api_key=YOUR_RPC_KEY

# SolanaTracker Data API key for @solana-tracker/data-api
SOLANATRACKER_DATA_API_KEY=YOUR_DATA_API_KEY

# Vault encoding mode: raw (default) or parsed
VAULT_ENCODING=raw

# Minimum quote reserve (SOL) for state labeling
MIN_QUOTE_SOL=35

# Logging verbosity (development, test, production)
NODE_ENV=development
